NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loadsmart
JWT_SECRET=
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_MS=2592000000
SIGNUP_OTP_TTL_SECONDS=600
LOGIN_OTP_TTL_SECONDS=600
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=30
USER_EXISTS_CACHE_TTL_SECONDS=30
PERMISSIONS_VERSION_CACHE_TTL_SECONDS=30
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_OTP_REQUEST_RATE_LIMIT_MAX=20
LOGIN_OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_OTP_VERIFY_RATE_LIMIT_MAX=20
LOGIN_OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300
VERIFY_OTP_RATE_LIMIT_MAX=20
VERIFY_OTP_RATE_LIMIT_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=300

CORS_ORIGINS=http://localhost:3000
AWS_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MSG91 OTP API — generates and verifies signup/login OTPs. Leave unset in development to use
# the fixed dev-only OTP instead (see auth.constants.ts's DEV_BYPASS_OTP).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com

# MSG91 Flow API — transactional/notification SMS (notifications module's SmsChannel), distinct
# from MSG91_TEMPLATE_ID above (that one's OTP-only). Leave unset in development; SmsChannel then
# fails loudly per-notification instead of crashing the server.
MSG91_NOTIFICATION_TEMPLATE_ID=

# MSG91 WhatsApp Business API — vehicle compliance-expired alerts (notifications module's
# WhatsappChannel). The message copy is a Meta-approved template created on the MSG91/WhatsApp
# Business dashboard under this template name/namespace; this app only sends variables into it, in
# {{1}}/{{2}}/{{3}}... placeholder order (see catalog/vehicle-notifications.catalog.ts). This API
# lives on a different host (api.msg91.com) from MSG91_BASE_URL (control.msg91.com) above.
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_BASE_URL=https://api.msg91.com

# MSG91 Email API — notifications module's EmailChannel. The sending domain must be added and
# verified (TXT/MX records) on the MSG91 dashboard first. Same MSG91_AUTH_KEY as above.
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=Loadsmart
# Optional reply-to for notification emails (a monitored inbox). Unset = replies go to MSG91_EMAIL_FROM.
MSG91_EMAIL_REPLY_TO=

# Per-notification MSG91 templates (catalog/notification-catalog.ts's `templates`). LS_N_0001
# "account approved": WhatsApp {{1}}=first_name {{2}}=org_name; SMS Flow var `var1`=org_name;
# email template variables `first_name`, `org_name` (subject is set in the MSG91 template).
MSG91_WHATSAPP_TEMPLATE_ORG_APPROVED=
MSG91_SMS_TEMPLATE_ORG_APPROVED=
MSG91_EMAIL_TEMPLATE_ORG_APPROVED=
# LS_N_0002 "signup received, under review": SMS Flow var `var1`=org_name; email template
# variables `first_name`, `org_name` (subject "We have your application for {{org_name}}", body
# = the spec's message copy). No WhatsApp, and not shown in-app (no app access yet).
MSG91_SMS_TEMPLATE_SIGNUP_RECEIVED=
MSG91_EMAIL_TEMPLATE_SIGNUP_RECEIVED=
# LS_N_0003 "more information needed": SMS Flow var `var1`=org_name; email template variables
# `first_name`, `org_name`, `doc_type` (subject "One document pending for {{org_name}}", body =
# the spec's message copy). Sent again once after 48h if the document is still invalid.
MSG91_SMS_TEMPLATE_DOCUMENT_PENDING=
MSG91_EMAIL_TEMPLATE_DOCUMENT_PENDING=
# LS_N_0004 "account not approved": email only — template variables `first_name`, `org_name`,
# `reason` (subject "About your Loadsmart application for {{org_name}}", body = the spec's copy).
MSG91_EMAIL_TEMPLATE_ORG_NOT_APPROVED=
# LS_N_0005 "team member invited": SMS Flow var `var1`=org_name; email template variables
# `first_name`, `inviter_name`, `org_name`, `capability_summary` (subject "{{inviter_name}} has
# added you to {{org_name}} on Loadsmart"). Reminder once after 24h if they haven't signed in yet.
MSG91_SMS_TEMPLATE_TEAM_INVITE=
MSG91_EMAIL_TEMPLATE_TEAM_INVITE=
# LS_N_0006 "your access changed": email template variables `first_name`, `admin_name`,
# `org_name`, `added_capabilities`, `removed_capabilities` (either may be empty) and
# `access_summary` (the ready-made "You can now … / … is no longer available" sentences).
MSG91_EMAIL_TEMPLATE_ACCESS_CHANGED=

# Firebase Cloud Messaging — push notifications (notifications module's PushChannel). Leave unset
# in development; push delivery then fails loudly per-notification instead of crashing the
# server. FIREBASE_PRIVATE_KEY must be the full PEM key with literal \n for newlines, exactly as
# exported in the Firebase service-account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
