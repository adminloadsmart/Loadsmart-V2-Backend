NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loadsmart
JWT_SECRET=
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_MS=2592000000
SIGNUP_OTP_TTL_SECONDS=600
LOGIN_OTP_TTL_SECONDS=600
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=30
USER_EXISTS_CACHE_TTL_SECONDS=30
PERMISSIONS_VERSION_CACHE_TTL_SECONDS=30
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_OTP_REQUEST_RATE_LIMIT_MAX=20
LOGIN_OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_OTP_VERIFY_RATE_LIMIT_MAX=20
LOGIN_OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300
VERIFY_OTP_RATE_LIMIT_MAX=20
VERIFY_OTP_RATE_LIMIT_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=300

CORS_ORIGINS=http://localhost:3000
AWS_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MSG91 OTP API — generates and verifies signup/login OTPs. Leave unset in development to use
# the fixed dev-only OTP instead (see auth.constants.ts's DEV_BYPASS_OTP).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com

# ULIP (DPIIT) — SARATHI driving-licence and VAHAN vehicle registry checks. Leave unset to fall
# back to manual_review on every check (see UlipClient).
ULIP_USERNAME=
ULIP_PASSWORD=
ULIP_BASE_URL=https://www.ulipstaging.dpiit.gov.in/ulip/v1.0.0
