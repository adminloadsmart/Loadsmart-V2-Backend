NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loadsmart
JWT_SECRET=
REDIS_URL=redis://localhost:6379
# Tracking service's Redis — gives the driver Home screen its ETA / km left. Leave unset to hide them.
TRACKING_REDIS_URL=redis://localhost:6380
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_MS=2592000000
SIGNUP_OTP_TTL_SECONDS=600
LOGIN_OTP_TTL_SECONDS=600
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=30
# LS_N_0008 OTP throttle, per phone number AND per client IP (separately): more than MAX requests
# within WINDOW locks that phone/IP out of OTP requests for LOCKOUT. Sheet: 3 in 15 min, 30 min.
OTP_REQUEST_LIMIT_MAX=3
OTP_REQUEST_LIMIT_WINDOW_SECONDS=900
OTP_REQUEST_LOCKOUT_SECONDS=1800
USER_EXISTS_CACHE_TTL_SECONDS=30
PERMISSIONS_VERSION_CACHE_TTL_SECONDS=30
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_OTP_REQUEST_RATE_LIMIT_MAX=20
LOGIN_OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_OTP_VERIFY_RATE_LIMIT_MAX=20
LOGIN_OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300
VERIFY_OTP_RATE_LIMIT_MAX=20
VERIFY_OTP_RATE_LIMIT_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=300

CORS_ORIGINS=http://localhost:3000
AWS_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MSG91 — signup/login OTPs are sent as a normal SMS (Flow API) and verified by the backend.
# Leave MSG91_AUTH_KEY unset in development to use the fixed dev-only OTP instead (see
# auth.constants.ts's DEV_BYPASS_OTP).
MSG91_AUTH_KEY=
# LS_N_0008: optional WhatsApp copy of the login OTP — Meta-approved template, {{1}} = the OTP.
MSG91_WHATSAPP_TEMPLATE_OTP=
# LS_N_0008: the OTP SMS template for staff signup + org/platform login — a DLT-approved MSG91
# Flow (SMS) template with the code in ##var1##. Required whenever MSG91_AUTH_KEY is set.
MSG91_SMS_TEMPLATE_OTP=
MSG91_BASE_URL=https://control.msg91.com
# true = skip notification SMS/WhatsApp to test numbers starting with 88888 (the login OTP still
# goes). Off unless set to true — every number gets everything.
MSG91_SKIP_TEST_NUMBERS=

# MSG91 Flow API — transactional/notification SMS (notifications module's SmsChannel), distinct
# from MSG91_SMS_TEMPLATE_OTP above (that one's OTP-only). Leave unset in development; SmsChannel then
# fails loudly per-notification instead of crashing the server.
MSG91_NOTIFICATION_TEMPLATE_ID=

# MSG91 WhatsApp Business API — vehicle compliance-expired alerts (notifications module's
# WhatsappChannel). The message copy is a Meta-approved template created on the MSG91/WhatsApp
# Business dashboard under this template name/namespace; this app only sends variables into it, in
# {{1}}/{{2}}/{{3}}... placeholder order (see catalog/vehicle-notifications.catalog.ts). This API
# lives on a different host (api.msg91.com) from MSG91_BASE_URL (control.msg91.com) above.
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_BASE_URL=https://api.msg91.com

# MSG91 Email API — notifications module's EmailChannel. The sending domain must be added and
# verified (TXT/MX records) on the MSG91 dashboard first. Same MSG91_AUTH_KEY as above.
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=Loadsmart
# Optional reply-to for notification emails (a monitored inbox). Unset = replies go to MSG91_EMAIL_FROM.
MSG91_EMAIL_REPLY_TO=

# Per-notification MSG91 templates (catalog/notification-catalog.ts's `templates`). LS_N_0001
# "account approved": WhatsApp {{1}}=first_name {{2}}=org_name; SMS Flow var `var1`=org_name;
# email template variables `first_name`, `org_name` (subject is set in the MSG91 template).
MSG91_WHATSAPP_TEMPLATE_ORG_APPROVED=
MSG91_SMS_TEMPLATE_ORG_APPROVED=
MSG91_EMAIL_TEMPLATE_ORG_APPROVED=
# LS_N_0029 "tracking signal lost": WhatsApp {{1}}=first_name {{2}}=vehicle_no {{3}}=hours_since
# {{4}}=last_location, plus a static "Open load" button set up on the template.
MSG91_WHATSAPP_TEMPLATE_TRACKING_SIGNAL_LOST=
# LS_N_0030 "delivery will be late": WhatsApp {{1}}=first_name {{2}}=load_code {{3}}=consignee
# {{4}}=delay {{5}}=revised_eta; DLT SMS Flow vars `var1`=load_code `var2`=revised_eta.
MSG91_WHATSAPP_TEMPLATE_DELIVERY_LATE=
MSG91_SMS_TEMPLATE_DELIVERY_LATE=
# LS_N_0002 "signup received, under review": SMS Flow var `var1`=org_name; email template
# variables `first_name`, `org_name` (subject "We have your application for {{org_name}}", body
# = the spec's message copy). No WhatsApp, and not shown in-app (no app access yet).
MSG91_SMS_TEMPLATE_SIGNUP_RECEIVED=
MSG91_EMAIL_TEMPLATE_SIGNUP_RECEIVED=
# LS_N_0003 "more information needed": SMS Flow var `var1`=org_name; email template variables
# `first_name`, `org_name`, `doc_type` (subject "One document pending for {{org_name}}", body =
# the spec's message copy). Sent again once after 48h if the document is still invalid.
MSG91_SMS_TEMPLATE_DOCUMENT_PENDING=
MSG91_EMAIL_TEMPLATE_DOCUMENT_PENDING=
# LS_N_0004 "account not approved": email only — template variables `first_name`, `org_name`,
# `reason` (subject "About your Loadsmart application for {{org_name}}", body = the spec's copy).
MSG91_EMAIL_TEMPLATE_ORG_NOT_APPROVED=
# LS_N_0005 "team member invited": SMS Flow var `var1`=org_name; email template variables
# `first_name`, `inviter_name`, `org_name`, `capability_summary` (subject "{{inviter_name}} has
# added you to {{org_name}} on Loadsmart"). Reminder once after 24h if they haven't signed in yet.
MSG91_SMS_TEMPLATE_TEAM_INVITE=
MSG91_EMAIL_TEMPLATE_TEAM_INVITE=
# LS_N_0006 "your access changed": email template variables `first_name`, `admin_name`,
# `org_name`, `added_capabilities`, `removed_capabilities` (either may be empty) and
# `access_summary` (the ready-made "You can now … / … is no longer available" sentences).
MSG91_EMAIL_TEMPLATE_ACCESS_CHANGED=
# LS_N_0007 "access removed" (MSG91 template ls_n_0007): email template variables `first_name`,
# `org_name`, `admin_name`, `reassigned_to`. The org admin's confirmation is in-app only.
MSG91_EMAIL_TEMPLATE_ACCESS_REMOVED=
# Web app address used to build each email's `cta_url` variable (the button link), e.g.
# https://app.loadsmart.in. Unset → `cta_url` is sent empty.
FRONTEND_BASE_URL=http://localhost:3000
# LS_N_0047 "vehicle document expiring": SMS var1=doc_type var2=vehicle_no. Weekly roll-up email:
# variables `first_name`, `doc_count`, `doc_list` (subject "{{doc_count}} vehicle documents
# expiring in the next 30 days").
MSG91_SMS_TEMPLATE_DOC_EXPIRING=
MSG91_EMAIL_TEMPLATE_DOC_ROLLUP=
# LS_N_0048 "vehicle document expired": SMS var1=vehicle_no var2=doc_type; email variables
# `vehicle_no`, `doc_type`, `expiry_date`, `affected_trip_count` (subject "{{vehicle_no}} blocked
# from dispatch, {{doc_type}} expired").
MSG91_SMS_TEMPLATE_DOC_EXPIRED=
MSG91_EMAIL_TEMPLATE_DOC_EXPIRED=
# LS_N_0049 "driver licence expired": SMS var1=driver_name.
MSG91_SMS_TEMPLATE_DL_EXPIRED=
# LS_N_0054 "driver marked a breakdown": SMS var1=vehicle_no var2=location; WhatsApp {{1}}=first_name
# {{2}}=vehicle_no {{3}}=location {{4}}=load_id {{5}}=driver_name {{6}}=driver_phone.
MSG91_SMS_TEMPLATE_BREAKDOWN=
MSG91_WHATSAPP_TEMPLATE_BREAKDOWN=
# LS_N_0056 "service due soon": SMS var1=vehicle_no var2=km_remaining. LS_N_0057 "service
# overdue": SMS var1=vehicle_no.
MSG91_SMS_TEMPLATE_SERVICE_DUE=
MSG91_SMS_TEMPLATE_SERVICE_OVERDUE=
# LS_N_0060 "daily morning brief": WhatsApp {{1}}=first_name {{2}}=trips_running {{3}}=delayed
# {{4}}=needs_action; email variables `first_name`, `org_name`, `needs_action`, `brief` (the full
# in-app text; subject "Your day at {{org_name}}: {{needs_action}} items need you").
MSG91_WHATSAPP_TEMPLATE_DAILY_BRIEF=
MSG91_EMAIL_TEMPLATE_DAILY_BRIEF=
# LS_N_0058 "tyre needs attention": SMS var1=vehicle_no var2=action_type (e.g. "retread and
# replacement" when one vehicle's tyres need different work).
MSG91_SMS_TEMPLATE_TYRE_ATTENTION=
# LS_N_0016 "truck and driver assigned": SMS var1=vehicle_no var2=load_code.
MSG91_SMS_TEMPLATE_VEHICLE_ASSIGNED=
# LS_N_0017 "assigned vehicle fails compliance": SMS var1=vehicle_no; WhatsApp {{1}}=first_name
# {{2}}=vehicle_no {{3}}=reference_code (load or requisition code) {{4}}=doc_type
# {{5}}=transporter_name.
MSG91_SMS_TEMPLATE_ASSIGNMENT_COMPLIANCE=
MSG91_WHATSAPP_TEMPLATE_ASSIGNMENT_COMPLIANCE=
# LS_N_0025 "e-way bill expires before delivery": SMS var1=vehicle_no; WhatsApp {{1}}=first_name
# {{2}}=load_code {{3}}=eway_bill_expiry {{4}}=eta.
MSG91_SMS_TEMPLATE_EWAY_BILL_EXPIRY=
MSG91_WHATSAPP_TEMPLATE_EWAY_BILL_EXPIRY=
# LS_N_0021 "vehicle not reported for loading": SMS var1=vehicle_no; WhatsApp {{1}}=first_name
# {{2}}=vehicle_no {{3}}=delay_duration {{4}}=origin {{5}}=load_code {{6}}=driver_name
# {{7}}=driver_phone.
MSG91_SMS_TEMPLATE_NOT_REPORTED=
MSG91_WHATSAPP_TEMPLATE_NOT_REPORTED=
# LS_N_0023 "detention started at loading": WhatsApp {{1}}=first_name {{2}}=vehicle_no {{3}}=origin
# {{4}}=detention_amount.
MSG91_WHATSAPP_TEMPLATE_DETENTION_LOADING=
# LS_N_0031 "vehicle reached unloading point": SMS var1=vehicle_no var2=consignee.
MSG91_SMS_TEMPLATE_REACHED_DROP=
# LS_N_0032 "detention started at unloading": WhatsApp {{1}}=first_name {{2}}=vehicle_no
# {{3}}=consignee {{4}}=detention_amount.
MSG91_WHATSAPP_TEMPLATE_DETENTION_UNLOADING=
# LS_N_0034 "shortage or damage recorded": email subject "Shortage of {{shortage_qty}} {{uom}} on
# {{load_id}} at {{consignee}}" — variables load_id, consignee, shortage_qty, uom, lr_no,
# claim_value, transporter_name, claim_window_days, claim_deadline.
MSG91_EMAIL_TEMPLATE_SHORTAGE_RECORDED=
# LS_N_0037 "driver reported a problem": SMS var1=load_id; WhatsApp {{1}}=first_name
# {{2}}=driver_name {{3}}=issue_type {{4}}=load_id {{5}}=location.
MSG91_SMS_TEMPLATE_DRIVER_PROBLEM=
MSG91_WHATSAPP_TEMPLATE_DRIVER_PROBLEM=
# LS_N_0038 "POD uploaded": SMS var1=load_id; email subject "POD uploaded for {{load_id}},
# {{origin}} to {{destination}}" — variables load_id, origin, destination, driver_name, lr_no,
# upload_time, amount.
MSG91_SMS_TEMPLATE_POD_UPLOADED=
MSG91_EMAIL_TEMPLATE_POD_UPLOADED=
# LS_N_0039 "POD still pending": WhatsApp {{1}}=first_name {{2}}=load_id {{3}}=hours_since
# {{4}}=amount ("Hi {{1}}, POD on {{2}} is {{3}} hours overdue and {{4}} is stuck behind it."),
# button "Chase POD". amount is empty on own-fleet loads.
MSG91_WHATSAPP_TEMPLATE_POD_PENDING=
# loadsmart-tracking REST API base URL (its PORT, 4100 locally) — LS_N_0025/0026 read a load's ETA
# from GET /v1/trips/:loadId. Leave empty to send those notifications without an ETA.
TRACKING_API_URL=

# Firebase Cloud Messaging — push notifications (notifications module's PushChannel). Leave unset
# in development; push delivery then fails loudly per-notification instead of crashing the
# server. FIREBASE_PRIVATE_KEY must be the full PEM key with literal \n for newlines, exactly as
# exported in the Firebase service-account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# TEMPORARY notification QA: 'true' mounts POST /v1/notifications/test/trigger-all, which sends every
# implemented notification once to the caller with sample data. Ignored when NODE_ENV=production.
NOTIFICATIONS_TEST_ENDPOINT=false
# Google Maps Places API — place search (autocomplete) + place details lookup (places module).
# Leave the key unset in development; the lookup endpoints then fail loudly instead of crashing boot.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
LOCATION_LOOKUP_RATE_LIMIT_MAX=20
LOCATION_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=300

# ULIP (DPIIT) VAHAN vehicle lookup — POST /v1/masters/vehicles/verify-vahan. ULIP only accepts
# whitelisted server IPs, so leave unset in development; the endpoint then fails loudly.
ULIP_BASE_URL=https://www.ulip.dpiit.gov.in/ulip/v1.0.0
ULIP_USERNAME=
ULIP_PASSWORD=
VEHICLE_VERIFY_VAHAN_RATE_LIMIT_MAX=5
VEHICLE_VERIFY_VAHAN_RATE_LIMIT_WINDOW_SECONDS=60
# enable triggering of vehicle compliance checks on vehicle creation/update (ULIP VAHAN lookup). If false,
