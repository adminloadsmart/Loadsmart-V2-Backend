    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed:roles": "ts-node -r reflect-metadata src/db/seed-roles.ts",
    "seed:platform-admin": "ts-node -r reflect-metadata src/db/seed-platform-admin.ts"
  },
