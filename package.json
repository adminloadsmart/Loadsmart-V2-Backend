    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typeorm": "ts-node -r reflect-metadata ./node_modules/typeorm/cli.js -d src/db/data-source.ts",
